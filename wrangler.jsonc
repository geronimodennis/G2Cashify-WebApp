{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "g2cashify",
  "workers_dev": true,
  "routes": [{ "pattern": "g2cashify.com", "custom_domain": true }],
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist"
  }
}
